<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Social Video Downloader</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <header class="app-header">
        <div class="container app-header-inner">
            <a class="brand" asp-controller="Home" asp-action="Index">
                <span class="brand-mark">↓</span>
                <span>
                    <strong>Social Video Downloader</strong>
                    <small>Kişisel video indirici</small>
                </span>
            </a>
            <nav class="app-nav">
                <a asp-controller="Home" asp-action="Index">Panel</a>
                <a asp-controller="History" asp-action="Index">Geçmiş</a>
                <a asp-controller="Settings" asp-action="Index">Ayarlar</a>
            </nav>
        </div>
    </header>
    <main class="container app-main">
        @RenderBody()
    </main>
    <footer class="app-footer">
        <div class="container">
            Bu uygulama yalnızca indirme hakkınız olan veya indirilmesine izin verilen içerikler içindir.
            DRM, erişim kontrolü ve platform korumalarını aşmaz.
        </div>
    </footer>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/lib/sweetalert2/sweetalert2.all.min.js"></script>
    <script src="~/js/api.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
