<div id="tool-banner" class="tool-banner d-none"></div>

<section class="panel">
    <div class="mode-tabs" role="tablist">
        <button id="tab-link" class="mode-tab is-active" type="button" role="tab" aria-selected="true" aria-controls="pane-link">Link</button>
        <button id="tab-file" class="mode-tab" type="button" role="tab" aria-selected="false" aria-controls="pane-file">TXT</button>
    </div>

    <div id="pane-link" role="tabpanel">
        <label for="download-category">Kategori</label>
        <select id="download-category" class="category-select"></select>
        <p class="hint">Video, seçilen kategorinin içinde platform klasörüne iner: Instagram, TikTok veya Twitter.</p>
        <label class="visually-hidden" for="video-url">Video URL</label>
        <input id="video-url" class="url-input" type="url" placeholder="https://www.instagram.com/reel/..." autocomplete="off" />
        <div class="action-row">
            <button id="info-button" class="btn btn-accent" type="button">Video Bilgisini Getir</button>
        </div>
    </div>

    <div id="pane-file" class="d-none" role="tabpanel">
        <label for="file-category">Kategori</label>
        <select id="file-category" class="category-select"></select>
        <p class="hint">Dosyadaki bütün adresler seçilen kategoriye iner. İçinde Instagram, TikTok ve Twitter klasörleri ayrı oluşur.</p>
        <div class="folder-row">
            <input id="url-file" class="url-file" type="file" accept=".txt,text/plain" />
            <button id="import-file" class="btn btn-accent" type="button">TXT'den İndir</button>
        </div>
    </div>
</section>

<section id="info-panel" class="panel d-none">
    <div class="info-grid">
        <img id="info-thumb" class="thumb d-none" alt="Video önizlemesi" />
        <div class="info-copy">
            <div class="meta-line"><span>Platform</span><strong id="info-platform"></strong></div>
            <div class="meta-line"><span>Başlık</span><strong id="info-title"></strong></div>
            <div class="meta-line"><span>Kullanıcı</span><strong id="info-uploader"></strong></div>
            <div class="meta-line"><span>Süre</span><strong id="info-duration"></strong></div>
            <div class="meta-line"><span>Çözünürlük</span><strong id="info-resolution"></strong></div>
            <div class="meta-line"><span>Format</span><strong id="info-format"></strong></div>
        </div>
    </div>
    <div class="folder-row">
        <div>
            <div class="section-label">İndirme Klasörü</div>
            <div id="info-folder" class="folder-path"></div>
        </div>
        <div class="action-row">
            <button id="change-folder" class="btn btn-ghost" type="button">Klasörü Değiştir</button>
            <button id="download-button" class="btn btn-accent" type="button">İndir</button>
        </div>
    </div>
</section>

<section class="panel">
    <h2>Uzaktan İndirme</h2>
    <div id="gist-status" class="hint">Durum yükleniyor...</div>
</section>

<section class="stats" id="stats"></section>

<section class="panel">
    <div class="section-heading">
        <h2>Son İndirmeler</h2>
    </div>
    <div id="recent-list" class="download-list"></div>
</section>

@section Scripts {
    <script src="~/js/dashboard.js" asp-append-version="true"></script>
}
