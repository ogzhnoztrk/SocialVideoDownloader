<form id="settings-form" class="settings-grid">
    <section class="panel">
        <h2>Genel</h2>
        <label for="download-directory">İndirme Klasörü</label>
        <div class="inline-field">
            <input id="download-directory" name="downloadDirectory" required />
            <button id="pick-folder" class="btn btn-ghost" type="button">Klasör Seç</button>
        </div>
        <label for="file-template">Dosya adlandırma</label>
        <input id="file-template" name="fileNameTemplate" required />
        <label class="check"><input id="use-date-folders" type="checkbox" /> Tarih klasörü kullan</label>
        <label class="check"><input id="duplicate-check" type="checkbox" /> Duplicate kontrolü</label>
    </section>

    <section class="panel">
        <h2>Downloader</h2>
        <p id="binary-status" class="hint"></p>
        <label for="ytdlp-path">yt-dlp yolu</label>
        <input id="ytdlp-path" placeholder="Boş bırakılırsa yerleşik konum kullanılır" />
        <label for="ffmpeg-path">FFmpeg yolu</label>
        <input id="ffmpeg-path" placeholder="Boş bırakılırsa yerleşik konum kullanılır" />
        <label class="check"><input id="auto-update" type="checkbox" /> Otomatik güncelle</label>
        <div class="action-row">
            <button id="install-ytdlp" class="btn btn-ghost" type="button">yt-dlp kur</button>
            <button id="install-ffmpeg" class="btn btn-ghost" type="button">FFmpeg kur</button>
        </div>
    </section>

    <section class="panel">
        <h2>Web</h2>
        <label for="listen-address">Yerel IP</label>
        <input id="listen-address" placeholder="127.0.0.1" required />
        <p class="hint">IIS site bağlaması gibi çalışır. 127.0.0.1 yalnızca bu bilgisayardır. Bu makinenin yerel ağ IP'sini yazarsanız panele http://IP:port adresinden de ulaşırsınız. Başka cihazlara açılmaz.</p>
        <label for="web-port">Port</label>
        <input id="web-port" type="number" min="1024" max="65535" required />
        <label class="check"><input id="open-on-startup" type="checkbox" /> Web arayüzünü açılışta aç</label>
    </section>

    <section class="panel">
        <h2>Windows</h2>
        <label class="check"><input id="start-with-windows" type="checkbox" /> Windows ile başlat</label>
        <p id="service-status" class="hint">Windows Service durumu yükleniyor...</p>
        <div class="action-row">
            <button id="install-service" class="btn btn-ghost" type="button">Servisi Kur</button>
            <button id="restart-service" class="btn btn-ghost" type="button">Servisi Yeniden Başlat</button>
            <button id="open-root" class="btn btn-ghost" type="button">İndirme Klasörünü Aç</button>
        </div>
        <p class="hint">Web ve tepsiyi birlikte açmak için proje klasöründeki Baslat.cmd dosyasına çift tıklayın. Windows ile başlat işaretliyken oturum açılınca ikisi de açılır. IP veya port değişince programı yeniden başlatın.</p>
    </section>

    <div class="action-row">
        <button class="btn btn-accent" type="submit">Kaydet</button>
    </div>
</form>

@section Scripts {
    <script src="~/js/settings.js" asp-append-version="true"></script>
}
